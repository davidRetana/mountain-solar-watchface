<resources>
    <properties>
        <property id="ElevationUnits" type="number">0</property>
        <property id="TemperatureUnits" type="number">0</property>
    </properties>
    <settings>
        <setting propertyKey="@Properties.ElevationUnits" title="@Strings.ElevationUnitsTitle">
            <settingConfig type="list">
                <listEntry value="0">@Strings.UseWatchUnits</listEntry>
                <listEntry value="1">@Strings.Meters</listEntry>
                <listEntry value="2">@Strings.Feet</listEntry>
            </settingConfig>
        </setting>
        <setting propertyKey="@Properties.TemperatureUnits" title="@Strings.TemperatureUnitsTitle">
            <settingConfig type="list">
                <listEntry value="0">@Strings.UseWatchUnits</listEntry>
                <listEntry value="1">@Strings.Celsius</listEntry>
                <listEntry value="2">@Strings.Fahrenheit</listEntry>
            </settingConfig>
        </setting>
    </settings>
</resources>
