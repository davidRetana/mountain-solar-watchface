// Snapshot used by the view. Missing readings remain null.
class WatchData {
    var timeText = "--:--";
    var dateText = "--";
    var heartRate = null;
    var heartRateWhen = null;
    var elevation = null;
    var elevationWhen = null;
    var city = null;
    var temperature = null;
    var weatherWhen = null;
    var solarInterval = null;
    var steps = null;
    var stepGoal = null;
    var battery = null;
    var batteryDays = null;
}
